# --- Claude (Anthropic) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Gmail SMTP (for sending the digest) ---
# NOT your normal password. Create an "App Password":
#   1. Enable 2-Step Verification on your Google account
#   2. https://myaccount.google.com/apppasswords -> create one for "Mail"
#   3. Paste the 16-char value below (spaces are fine)
GMAIL_ADDRESS=blaylock.steve@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the digest is delivered (defaults to GMAIL_ADDRESS if unset)
DIGEST_TO=blaylock.steve@gmail.com

# --- Optional overrides ---
# Any Anthropic model id works; prefixed with "anthropic/" for LiteLLM.
CLAUDE_MODEL=anthropic/claude-sonnet-5
